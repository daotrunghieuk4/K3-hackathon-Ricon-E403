{
  "name": "vlearn-quiz-agent-backend",
  "version": "1.0.0",
  "description": "Backend REST API Server for VLearn Active Recall Quiz Generator & AI Tutor",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "eval:validate": "python tool.py --validate-only",
    "eval:case": "python tool.py",
    "eval": "python tool.py --out ../eval/run_results_latest.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  }
}
